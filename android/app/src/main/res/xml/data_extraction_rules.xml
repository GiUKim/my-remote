<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing of the app goes into a cloud backup or to a new phone: its list of PCs holds device tokens, encrypted with a
     key of this phone's Keystore that would not open them anywhere else (a PC is added there again with its QR code). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
